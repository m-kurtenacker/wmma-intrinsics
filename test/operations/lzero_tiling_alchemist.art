type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f32;

static tile_size_x = 8;
static tile_size_y = 8;
static tile_size_k = 16;

static mut device_mp_count : i32;

static accelerator_time = get_kernel_time;

fn @get_accelerator () {
    let device_number = 0;

    print_string("Initializing device ");
    print_string(runtime_device_name(runtime_device(5, device_number)));
    print_string("\n");

    device_mp_count = runtime_device_nodes(runtime_device(5, device_number));
    levelzero_accelerator(device_number)
}

