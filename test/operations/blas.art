static accelerator_time = get_micro_time;

fn get_accelerator() = get_accelerator_cpu();

fn @get_accelerator_cpu () {
    print_string("Initializing virtual CPU device\n");

    device_mp_count = 20;

    fn @local_exec(body : fn(WorkItem) -> ()) = @|grid : (i32, i32, i32), _block : (i32, i32, i32)| {
        for x in range(0, grid.0) {
            for y in range(0, grid.1) {
                for z in range(0, grid.2) {
                    @body(WorkItem {
                        tidx  = @|| { x },
                        tidy  = @|| { y },
                        tidz  = @|| { z },
                        bidx  = @|| { x },
                        bidy  = @|| { y },
                        bidz  = @|| { z },
                        gidx  = @|| { x },
                        gidy  = @|| { y },
                        gidz  = @|| { z },
                        bdimx = @|| { 1 },
                        bdimy = @|| { 1 },
                        bdimz = @|| { 1 },
                        gdimx = @|| { grid.0 },
                        gdimy = @|| { grid.1 },
                        gdimz = @|| { grid.2 },
                        nblkx = @|| { grid.0 },
                        nblky = @|| { grid.1 },
                        nblkz = @|| { grid.2 },
                    });
                }
            }
        }
    };

    fn @alloc_align(size: i64) = Buffer {
        //data = aligned_alloc(32, size),
        data = mkl_malloc(size, 64),
        size = size,
        device = 0
    };

    Accelerator {
        exec = local_exec,
        sync = @|| { },
        alloc = alloc_align,
        alloc_unified = alloc_cpu,
        barrier = @|| { },
    }
}

fn @get_accelerator_nvvm () {
    device_mp_count = runtime_device_nodes(runtime_device(1, 0));
    nvvm_accelerator(0)
}

fn @get_accelerator_hip () {
    device_mp_count = runtime_device_nodes(runtime_device(3, 1));
    amdgpu_hsa_accelerator(1)
}

fn @accelerated_matmul (_cpu : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    /*for x in range(0, c.x_dim) {
        for y in range(0, c.y_dim) {
            d.data(addr_tensor(x, y, d)) = c.data(addr_tensor(x, y, d));
        }
    }*/

    //f32
    cblas_scopy(c.x_dim * c.y_dim, c.data, 1, d.data, 1);
    //f16
    //cblas_scopy((c.x_dim * c.y_dim) / 2, bitcast[&[f32]](c.data), 1, bitcast[&mut[f32]](d.data), 1);

    matrix_multiply_blas(a, b, d);
}

fn @warmup_matmul (cpu : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    @accelerated_matmul (cpu, a, b, c, d);
}


static num_threads = 32;
static block_size = 64;

fn @ref_matmul (a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    let m = a.y_dim;
    let n = b.x_dim;
    //assert(a.x_dim == b.y_dim);
    let k = a.x_dim;

    let blocksize_thread = m / num_threads;

    for t in parallel(num_threads, 0, num_threads) {
        let ts = t * blocksize_thread;
        let te = (t + 1) * blocksize_thread;

        for y in range_step(ts, te, block_size) {
            for x in range_step(0, n, block_size) {
                for i in range(0, 1) {
                    let sub_a = sub_tensor(a, i, y, block_size, block_size);
                    let sub_b = sub_tensor(b, x, i, block_size, block_size);
                    let sub_c = sub_tensor(c, x, y, block_size, block_size);
                    let sub_d = sub_tensor(d, x, y, block_size, block_size);
                    matrix_multiply_naive(sub_a, sub_b, sub_c, sub_d);
                }

                for i in range_step(block_size, k, block_size) {
                    let sub_a = sub_tensor(a, i, y, block_size, block_size);
                    let sub_b = sub_tensor(b, x, i, block_size, block_size);
                    let sub_d = sub_tensor(d, x, y, block_size, block_size);
                    matrix_multiply_naive(sub_a, sub_b, sub_d, sub_d);
                }
            }
        }
    }
}
