type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f32;

static tile_size_x = 16;
static tile_size_y = 16;
static tile_size_k = 16;

static block_x_tiles = 0;
static block_y_tiles = 0;

static warp_x_tiles = 0;
static warp_y_tiles = 0;

static k_shared_tiles = 0;
static skew_half = 0;
static pb_factor = 4;

static mut device_mp_count : i32;

static accelerator_time = get_kernel_time;

struct WMMA_OP[_T] {
    blocked : fn(Accelerator, Tensor[a_element_type], Tensor[b_element_type], Tensor[c_element_type], Tensor[c_element_type]) -> (),
    wmma : fn(Accelerator, Tensor[a_element_type], Tensor[b_element_type], Tensor[c_element_type], Tensor[c_element_type]) -> ()
}

implicit = WMMA_OP[f16] {
    blocked = @|hsa, a, b, c, d| {
        matrix_multiply_acc_blocked [amdgfx11_mat_datatype, amdgfx11_mat_datatype, amdgfx11_acc_f16_datatype] (hsa, GFX11WMMAOperations, a, b, c, d);
    },
    wmma = @|hsa, a, b, c, d| {
        matrix_multiply_acc_wmma [amdgfx11_mat_datatype, amdgfx11_mat_datatype, amdgfx11_acc_f16_datatype] (hsa, GFX11WMMAOperations, a, b, c, d);
    },
};

implicit = WMMA_OP[f32] {
    blocked = @|hsa, a, b, c, d| {
        matrix_multiply_acc_blocked [amdgfx11_mat_datatype, amdgfx11_mat_datatype, amdgfx11_acc_f32_datatype] (hsa, GFX11WMMAOperationsF32, a, b, c, d);
    },
    wmma = @|hsa, a, b, c, d| {
        matrix_multiply_acc_wmma [amdgfx11_mat_datatype, amdgfx11_mat_datatype, amdgfx11_acc_f32_datatype] (hsa, GFX11WMMAOperationsF32, a, b, c, d);
    },
};

fn @get_accelerator () {
    print_string("Initializing device ");
    print_string(runtime_device_name(runtime_device(3, 1)));
    print_string("\n");

    device_mp_count = runtime_device_nodes(runtime_device(3, 1));
    amdgpu_hsa_accelerator(1)
}

fn @accelerated_matmul (hsa : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type], implicit wmma : WMMA_OP[c_element_type]) -> () {
    wmma.wmma(hsa, a, b, c, d);
}

fn @ref_matmul (a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    for x in range(0, c.x_dim) {
        for y in range(0, c.y_dim) {
            d.data(addr_tensor(x, y, d)) = c.data(addr_tensor(x, y, d));
        }
    }

    matrix_multiply_blas(a, b, d);
}
