type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f32;

static tile_size_x = 16;
static tile_size_y = 16;
static tile_size_k = 16;

static block_x_tiles = 8;
static block_y_tiles = 8;

static warp_x_tiles = 2;
static warp_y_tiles = 4;

static k_shared_tiles = 4;
static skew_half = 16;
static pb_factor = 2;

static mut device_mp_count : i32;

static accelerator_time = get_kernel_time;

struct WMMA_OP[_T] {
    blocked : fn(Accelerator, Tensor[a_element_type], Tensor[b_element_type], Tensor[c_element_type], Tensor[c_element_type]) -> (),
    wmma : fn(Accelerator, Tensor[a_element_type], Tensor[b_element_type], Tensor[c_element_type], Tensor[c_element_type]) -> ()
}

implicit = WMMA_OP[f16] {
    blocked = @|nvvm, a, b, c, d| {
        @matrix_multiply_acc_blocked [nvvm_mat_datatype, nvvm_mat_datatype, nvvm_acc_f16_datatype] (nvvm, NVVMWMMAOperations, a, b, c, d);
    },
    wmma = @|nvvm, a, b, c, d| {
        @matrix_multiply_acc_wmma [nvvm_mat_datatype, nvvm_mat_datatype, nvvm_acc_f16_datatype] (nvvm, NVVMWMMAOperations, a, b, c, d);
    },
};

implicit = WMMA_OP[f32] {
    blocked = @|nvvm, a, b, c, d| {
        @matrix_multiply_acc_blocked [nvvm_mat_datatype, nvvm_mat_datatype, nvvm_acc_f32_datatype] (nvvm, NVVMWMMAOperationsF32, a, b, c, d);
    },
    wmma = @|nvvm, a, b, c, d| {
        @matrix_multiply_acc_wmma [nvvm_mat_datatype, nvvm_mat_datatype, nvvm_acc_f32_datatype] (nvvm, NVVMWMMAOperationsF32, a, b, c, d);
    },
};

fn @get_accelerator () {
    print_string("Initializing device ");
    print_string(runtime_device_name(runtime_device(1, 0)));
    print_string("\n");

    device_mp_count = runtime_device_nodes(runtime_device(1, 0));
    nvvm_accelerator(0)
}

fn @accelerated_matmul (nvvm : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type], implicit wmma : WMMA_OP[c_element_type]) -> () {
    if (M % 128 == 0 && N % 128 == 0) {
        @wmma.blocked(nvvm, a, b, c, d)
    } else {
        @wmma.wmma(nvvm, a, b, c, d)
    }
}

fn @warmup_matmul (nvvm : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type], implicit wmma : WMMA_OP[c_element_type]) -> () {
    @wmma.wmma(nvvm, a, b, c, d)
}
