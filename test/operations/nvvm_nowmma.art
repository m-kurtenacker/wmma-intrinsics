type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f32;

static tile_size_x = 16;
static tile_size_y = 16;
static tile_size_k = 16;

static mut device_mp_count : i32;

static accelerator_time = get_kernel_time;

fn @get_accelerator () {
    print_string("Initializing device ");
    print_string(runtime_device_name(runtime_device(1, 0)));
    print_string("\n");

    device_mp_count = runtime_device_nodes(runtime_device(1, 0));
    nvvm_accelerator(0)
}

fn @accelerated_matmul (nvvm : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    matrix_multiply_acc_wmma [simple_mat_a_datatype, simple_mat_b_datatype, simple_acc_datatype] (nvvm, SimpleMMAOperations(nvvm_read_ptx_sreg_tid_x), a, b, c, d);
}

fn @ref_matmul (a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    matrix_multiply_naive(a, b, c, d);
}
