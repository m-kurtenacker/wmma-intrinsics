type a_element_type = f16;
type b_element_type = f16;
type c_element_type = f16;

static tile_size_x = 16;
static tile_size_y = 16;
static tile_size_k = 16;

static block_x_tiles = 8;
static block_y_tiles = 8;

static warp_x_tiles = 2;
static warp_y_tiles = 4;

static k_shared_tiles = 4;
static skew_half = 16;
static pb_factor = 2;

static mut device_mp_count : i32;

static accelerator_time = get_kernel_time;

fn @get_accelerator () {
    print_string("Initializing device ");
    print_string(runtime_device_name(runtime_device(1, 0)));
    print_string("\n");

    device_mp_count = runtime_device_nodes(runtime_device(1, 0));
    cuda_accelerator(0)
}

fn @accelerated_matmul (cuda : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    if (M % 128 == 0 && N % 128 == 0) {
        @matrix_multiply_acc_blocked [cuda_mat_datatype, cuda_mat_datatype, cuda_acc_datatype] (cuda, CUDAWMMAOperations, a, b, c, d);
    } else {
        @matrix_multiply_acc_wmma [cuda_mat_datatype, cuda_mat_datatype, cuda_acc_datatype] (cuda, CUDAWMMAOperations, a, b, c, d);
    }
}

fn @warmup_matmul (cuda : Accelerator, a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type], d : Tensor[c_element_type]) -> () {
    @matrix_multiply_acc_wmma [cuda_mat_datatype, cuda_mat_datatype, cuda_acc_datatype] (cuda, CUDAWMMAOperations, a, b, c, d);
}
