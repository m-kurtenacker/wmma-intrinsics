/*
 * D = A * B + C
 *
 * Where:
 *
 * A:    (  -> K )
 *       (       )
 *       (| M    )
 *       (V      )
 *
 * B:    (  -> N )
 *       (       )
 *       (| K    )
 *       (V      )
 *
 * C, D: (  -> N )
 *       (       )
 *       (| M    )
 *       (V      )
 */

/*
layout:
RowMajor => 101,
ColMajor => 102,

transpose:
no_transpose => 111
transpose => 112
conj_transpose => 113
*/

#[import(cc="C", name="cblas_hgemm")]
fn cblas_hgemm_cuda (_layout : i32, _transpose_a : i32, _transpose_b: i32, _m : i64, _n : i64, _k : i64, _alpha : i16, _a : &mut [f16], _stride_a : i64, _b : &mut [f16], _stride_b : i64, _beta : i16, _c : &mut [f16], _stride_c : i64) -> ();

fn cblas_hgemm (layout : i32, transpose_a : i32, transpose_b: i32, m : i64, n : i64, k : i64, alpha : f16, a : &mut [f16], stride_a : i64, b : &mut [f16], stride_b : i64, beta : f16, c : &mut [f16], stride_c : i64) -> () = @cblas_hgemm_cuda(layout, transpose_a, transpose_b, m, n, k, bitcast[i16](alpha), a, stride_a, b, stride_b, bitcast[i16](beta), c, stride_c);

#[import(cc="C", name="cblas_sgemm")]
fn cblas_sgemm (_layout : i32, _transpose_a : i32, _transpose_b: i32, _m : i64, _n : i64, _k : i64, _alpha : f32, _a : &mut [f32], _stride_a : i64, _b : &mut [f32], _stride_b : i64, _beta : f32, _c : &mut [f32], _stride_c : i64) -> ();

#[import(cc="C", name="cblas_dgemm")]
fn cblas_dgemm (_layout : i32, _transpose_a : i32, _transpose_b: i32, _m : i64, _n : i64, _k : i64, _alpha : f64, _a : &mut [f64], _stride_a : i64, _b : &mut [f64], _stride_b : i64, _beta : f64, _c : &mut [f64], _stride_c : i64) -> ();

#[import(cc="C", name="cblas_scopy")]
fn cblas_scopy(_n : i32, _x : &[f32], _incx : i32, _y : &mut [f32], _incy : i32) -> ();

enum CBLAS_LAYOUT {CblasRowMajor, CblasColMajor}
fn cblas_layout_to_int (l : CBLAS_LAYOUT) { match l { CBLAS_LAYOUT::CblasRowMajor => 101, CBLAS_LAYOUT::CblasColMajor => 102 } }

enum CBLAS_TRANSPOSE {CblasNoTrans, CblasTrans, CblasConjTrans}
fn cblas_transpose_to_int (t : CBLAS_TRANSPOSE) { match t { CBLAS_TRANSPOSE::CblasNoTrans => 111, CBLAS_TRANSPOSE::CblasTrans => 112, CBLAS_TRANSPOSE::CblasConjTrans => 113 } }

struct gemm_impl[T] {
    function : fn (i32, i32, i32, i64, i64, i64, T, &mut [T], i64, &mut [T], i64, T, &mut [T], i64) -> ()
}

implicit = gemm_impl[f64] { function = cblas_dgemm };
implicit = gemm_impl[f32] { function = cblas_sgemm };
implicit = gemm_impl[f16] { function = cblas_hgemm };

fn cblas_gemm[T] (layout : CBLAS_LAYOUT, transpose_a : CBLAS_TRANSPOSE, transpose_b : CBLAS_TRANSPOSE, m : i64, n : i64, k : i64, alpha : T, a : &mut [T], stride_a : i64, b : &mut [T], stride_b : i64, beta : T, c : &mut [T], stride_c : i64, implicit impl : gemm_impl[T]) -> () {
    impl.function(cblas_layout_to_int(layout), cblas_transpose_to_int(transpose_a), cblas_transpose_to_int(transpose_b), m, n, k, alpha, a, stride_a, b, stride_b, beta, c, stride_c);
}


struct convert_function[T] { convert : fn (T) -> f32 }
implicit = convert_function[f16] { convert = @| a | { a as f32 } };
implicit = convert_function[f32] { convert = @| a | { a } };
implicit = convert_function[f64] { convert = @| a | { a as f32 } };

fn convert_tensor[T] (src : Tensor[T], implicit convert : convert_function[T]) -> Tensor[f32] {
    let dst_cpu = bitcast[&mut[f32]](alloc_cpu(sizeof[f32]() * src.x_dim as i64 * src.y_dim as i64).data);

    let dst = Tensor[f32] { data = dst_cpu, x_dim = src.x_dim, y_dim = src.y_dim, addr_mode = src.addr_mode, stride = src.stride };

    for x in range(0, src.x_dim) {
        for y in range(0, src.y_dim) {
            dst.data(addr_tensor(x, y, dst)) = convert.convert(src.data(addr_tensor(x, y, src)));
        }
    }

    dst
}

//Warning: This is only legal if S == T. But it has to exist for compatibility reasons.
fn @id_convert[S, T] (src : Tensor[S]) = Tensor[T] {
    data = bitcast[&mut [T]](src.data),
    x_dim = src.x_dim,
    y_dim = src.y_dim,
    addr_mode = src.addr_mode,
    stride = src.stride
};

fn matrix_multiply_blas(a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type]) = matrix_multiply_blas_converted(a, b, c);

fn matrix_multiply_blas_converted (a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type]) -> () {
    let m = a.y_dim as i64;
    let n = b.x_dim as i64;
    //assert(a.x_dim == b.y_dim);
    let k = a.x_dim as i64;

    let a_f32 = if (sizeof[a_element_type]() == 4 : i64) { //if a_element_type == f32, but worse.
        id_convert[a_element_type, f32](a)
    } else {
        convert_tensor[a_element_type](a)
    };
    let b_f32 = if (sizeof[b_element_type]() == 4 : i64) {
        id_convert[b_element_type, f32](b)
    } else {
        convert_tensor[b_element_type](b)
    };
    let c_f32 = if (sizeof[c_element_type]() == 4 : i64) {
        id_convert[c_element_type, f32](c)
    } else {
        convert_tensor[c_element_type](c)
    };

    cblas_gemm[f32](
            match c.addr_mode {
                AddrMode::RowMajor => CBLAS_LAYOUT::CblasRowMajor,
                AddrMode::ColMajor => CBLAS_LAYOUT::CblasColMajor,
            },
            match (c.addr_mode, a.addr_mode) {
                (AddrMode::RowMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasTrans,
                (AddrMode::RowMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasTrans,
            },
            match (c.addr_mode, b.addr_mode) {
                (AddrMode::RowMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasTrans,
                (AddrMode::RowMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasTrans,
            },
            m, n, k, 1.0, bitcast[&mut [f32]](a_f32.data), a_f32.stride as i64, bitcast[&mut [f32]](b_f32.data), b_f32.stride as i64, 1.0, bitcast[&mut [f32]](c_f32.data), c_f32.stride as i64);

    if (sizeof[c_element_type]() != 4 : i64) {
        for x in range(0, c_f32.x_dim) {
            for y in range(0, c_f32.y_dim) {
                c.data(addr_tensor(x, y, c)) = c_f32.data(addr_tensor(x, y, c_f32)) as c_element_type;
            }
        }
    }
}

fn matrix_multiply_blas_native (a : Tensor[a_element_type], b : Tensor[b_element_type], c : Tensor[c_element_type]) -> () {
    let m = a.y_dim as i64;
    let n = b.x_dim as i64;
    //assert(a.x_dim == b.y_dim);
    let k = a.x_dim as i64;

    cblas_gemm[c_element_type](
            match c.addr_mode {
                AddrMode::RowMajor => CBLAS_LAYOUT::CblasRowMajor,
                AddrMode::ColMajor => CBLAS_LAYOUT::CblasColMajor,
            },
            match (c.addr_mode, a.addr_mode) {
                (AddrMode::RowMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasTrans,
                (AddrMode::RowMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasTrans,
            },
            match (c.addr_mode, b.addr_mode) {
                (AddrMode::RowMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasNoTrans,
                (AddrMode::ColMajor, AddrMode::RowMajor) => CBLAS_TRANSPOSE::CblasTrans,
                (AddrMode::RowMajor, AddrMode::ColMajor) => CBLAS_TRANSPOSE::CblasTrans,
            },
            m, n, k, 1.0, bitcast[&mut [c_element_type]](a.data), a.stride as i64, bitcast[&mut [c_element_type]](b.data), b.stride as i64, 1.0, c.data, c.stride as i64);
}
