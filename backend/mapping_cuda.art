/*
 * D = A * B + C
 *
 * Where:
 *
 * A:    (  -> K )
 *       (       )
 *       (| M    )
 *       (V      )
 *
 * B:    (  -> N )
 *       (       )
 *       (| K    )
 *       (V      )
 *
 * C, D: (  -> N )
 *       (       )
 *       (| M    )
 *       (V      )
 */

type cuda_acc_datatype = (simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2]);
type cuda_mat_datatype = (simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2], simd[f16 * 2]);

#[import(cc = "device", name = "__hmma_m16n16k16_ld_a")] fn cuda_wmma_load_a (_frag : &i32, _data : &i32, _stride : u32, _mode: i32) -> ();
#[import(cc = "device", name = "__hmma_m16n16k16_ld_b")] fn cuda_wmma_load_b (_frag : &i32, _data : &i32, _stride : u32, _mode: i32) -> ();
#[import(cc = "device", name = "__hmma_m16n16k16_ld_c_f16")] fn cuda_wmma_load_c (_frag : &i32, _data : &i32, _stride : u32, _mode: i32) -> ();
#[import(cc = "device", name = "__hmma_m16n16k16_st_c_f16")] fn cuda_wmma_store_d (_data : &i32, _frag : &i32, _stride : u32, _mode: i32) -> ();

#[import(cc = "device", name = "__hmma_m16n16k16_mma_f16f16")] fn cuda_wmma_mma (_frag_d : &i32, _frag_a : &i32, _frag_b : &i32, _frag_c : &i32, _mode: i32, _satfinite: i32) -> ();


fn @cuda_wmma_expand (a_fragment : nvvm_mat_datatype, b_fragment : nvvm_mat_datatype, c_fragment : nvvm_acc_datatype, a_mode : AddrMode, b_mode : AddrMode) -> nvvm_acc_datatype {
    match (a_mode, b_mode) {
        (AddrMode::RowMajor, AddrMode::RowMajor) => {
            let mut d_fragment : cuda_acc_datatype;
            cuda_wmma_mma(bitcast[&i32](&d_fragment), bitcast[&i32](&a_fragment), bitcast[&i32](&b_fragment), bitcast[&i32](&c_fragment), 0, 0);
            d_fragment
        },
        (AddrMode::ColMajor, AddrMode::RowMajor) => {
            let mut d_fragment : cuda_acc_datatype;
            cuda_wmma_mma(bitcast[&i32](&d_fragment), bitcast[&i32](&a_fragment), bitcast[&i32](&b_fragment), bitcast[&i32](&c_fragment), 2, 0);
            d_fragment
        },
        (AddrMode::RowMajor, AddrMode::ColMajor) => {
            let mut d_fragment : cuda_acc_datatype;
            cuda_wmma_mma(bitcast[&i32](&d_fragment), bitcast[&i32](&a_fragment), bitcast[&i32](&b_fragment), bitcast[&i32](&c_fragment), 1, 0);
            d_fragment
        },
        (AddrMode::ColMajor, AddrMode::ColMajor) => {
            let mut d_fragment : cuda_acc_datatype;
            cuda_wmma_mma(bitcast[&i32](&d_fragment), bitcast[&i32](&a_fragment), bitcast[&i32](&b_fragment), bitcast[&i32](&c_fragment), 3, 0);
            d_fragment
        }
    }
}

fn @cuda_wmma_load_a_expand(fragment_tensor : Tensor[a_element_type]) -> cuda_mat_datatype {
    let cuda_data = bitcast[&i32](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor => {
            let mut fragment : cuda_mat_datatype;
            cuda_wmma_load_a(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 0);
            fragment
        },
        AddrMode::ColMajor => {
            let mut fragment : cuda_mat_datatype;
            cuda_wmma_load_a(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 1);
            fragment
        }
    }
}

fn @cuda_wmma_load_b_expand(fragment_tensor : Tensor[b_element_type]) -> cuda_mat_datatype {
    let cuda_data = bitcast[&i32](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor => {
            let mut fragment : cuda_mat_datatype;
            cuda_wmma_load_b(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 0);
            fragment
        },
        AddrMode::ColMajor => {
            let mut fragment : cuda_mat_datatype;
            cuda_wmma_load_b(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 1);
            fragment
        }
    }
}

fn @cuda_wmma_load_c_expand(fragment_tensor : Tensor[c_element_type]) -> cuda_acc_datatype {
    let cuda_data = bitcast[&i32](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor => {
            let mut fragment : cuda_acc_datatype;
            cuda_wmma_load_c(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 0);
            fragment
        },
        AddrMode::ColMajor => {
            let mut fragment : cuda_acc_datatype;
            cuda_wmma_load_c(bitcast[&i32](&fragment), cuda_data, fragment_tensor.stride as u32, 1);
            fragment
        }
    }
}

fn @cuda_wmma_store_d_expand(fragment_tensor : Tensor[c_element_type], acc_fragment : cuda_acc_datatype) -> () {
    let cuda_data = bitcast[&i32](fragment_tensor.data);

    match fragment_tensor.addr_mode {
        AddrMode::RowMajor => {
            cuda_wmma_store_d(cuda_data, bitcast[&i32](&acc_fragment), fragment_tensor.stride as u32, 0);
        },
        AddrMode::ColMajor => {
            cuda_wmma_store_d(cuda_data, bitcast[&i32](&acc_fragment), fragment_tensor.stride as u32, 1);
        }
    }
}

static CUDAWMMAOperations = WMMAOperations [cuda_mat_datatype, cuda_mat_datatype, cuda_acc_datatype] {
    load_a = @|fragment_tensor| {
        cuda_wmma_load_a_expand(fragment_tensor)
    },
    load_b = @|fragment_tensor| {
        cuda_wmma_load_b_expand(fragment_tensor)
    },
    load_c = @|fragment_tensor| {
        cuda_wmma_load_c_expand(fragment_tensor)
    },
    wmma = @|a_fragment, a_layout, b_fragment, b_layout, acc_fragment, _c_layout| {
        cuda_wmma_expand (a_fragment, b_fragment, acc_fragment, a_layout, b_layout)
    },
    store_d = @|fragment_tensor, acc_fragment| {
        cuda_wmma_store_d_expand (fragment_tensor, acc_fragment);
    }
};
