/*
 * D = A * B + C
 *
 * Where:
 *
 * A:    (  -> K )
 *       (       )
 *       (| M    )
 *       (V      )
 *
 * B:    (  -> N )
 *       (       )
 *       (| K    )
 *       (V      )
 *
 * C, D: (  -> N )
 *       (       )
 *       (| M    )
 *       (V      )
 */

//Tested with ROCm 6.3.3
//TODO: This requires a patch in runtime:
/* in hsa_platform.cpp:616
-    std::string attrs = "-trap-handler";
+    std::string attrs = "-trap-handler,+wavefrontsize32,-wavefrontsize64";
*/

type amdgfx12_acc_datatype = simd[c_element_type * 8];
type amdgfx12_mat_datatype = simd[a_element_type * 8];

#[import(cc = "device", name = "llvm.amdgcn.wmma.f16.16x16x16.f16.v8f16.v8f16")] fn amdgfx12_wmma(amdgfx12_mat_datatype, amdgfx12_mat_datatype, amdgfx12_acc_datatype, bool) -> amdgfx12_acc_datatype;

static GFX12WMMAOperations = WMMAOperations [amdgfx12_mat_datatype, amdgfx12_mat_datatype, amdgfx12_acc_datatype] {
    load_a = @|fragment_tensor| {
        let lane = amdgcn_workitem_id_x() % 16;
        let group = amdgcn_workitem_id_x() % wave_size / 16;

        let mut fragment : amdgfx12_mat_datatype;
        for ele in range(0, 8) {
            let r = ele + group * 8;
            fragment(ele) = fragment_tensor.data(addr_tensor(r, lane, fragment_tensor));
        }
        fragment
    },
    load_b = @|fragment_tensor| {
        let lane = amdgcn_workitem_id_x() % 16;
        let group = amdgcn_workitem_id_x() % wave_size / 16;

        let mut fragment : amdgfx12_mat_datatype;
        for ele in range(0, 8) {
            let r = ele + group * 8;
            fragment(ele) = fragment_tensor.data(addr_tensor(lane, r, fragment_tensor));
        }
        fragment
    },
    load_c = @|fragment_tensor| {
        let lane = amdgcn_workitem_id_x() % 16;
        let group = amdgcn_workitem_id_x() % wave_size / 16;

        let mut fragment : amdgfx12_acc_datatype;
        for ele in range(0, 8) {
            let r = ele + group * 8;

            fragment(ele) = fragment_tensor.data(addr_tensor(lane, r, fragment_tensor));
        }
        fragment
    },
    wmma = @|a_fragment, _a_layout, b_fragment, _b_layout, acc_fragment, _c_layout| {
        amdgfx12_wmma(a_fragment, b_fragment, acc_fragment, false)
    },
    store_d = @|fragment_tensor, acc_fragment| {
        let lane = amdgcn_workitem_id_x() % 16;
        let group = amdgcn_workitem_id_x() % wave_size / 16;

        for ele in range(0, 8) {
            let r = ele + group * 8;

            fragment_tensor.data(addr_tensor(lane, r, fragment_tensor)) = acc_fragment(ele);
        }
    }
};
