/*
 * D = A * B + C
 *
 * Where:
 *
 * A:    (  -> K )
 *       (       )
 *       (| M    )
 *       (V      )
 *
 * B:    (  -> N )
 *       (       )
 *       (| K    )
 *       (V      )
 *
 * C, D: (  -> N )
 *       (       )
 *       (| M    )
 *       (V      )
 */

//These need backend support in thorin that is not present right now. Please refer to https://github.com/m-kurtenacker/thorin/tree/matmul and https://github.com/AnyDSL/artic/tree/feature/extern_type.

//See https://github.khronos.org/SPIRV-Registry/extensions/KHR/SPV_KHR_cooperative_matrix.html for IDs.

//4456 = OpTypeCooperativeMatrixKHR
//Scope 2 = WorkGroup; spirv.h:958
//Scope 3 = SubGroup; spirv.h:959

type_ext alchemist_acc_datatype   = "spirv" { "4456", "float", "3",  "8",  "8", "2" };
type_ext alchemist_mat_a_datatype = "spirv" { "4456",  "half", "3",  "8", "16", "0" };
type_ext alchemist_mat_b_datatype = "spirv" { "4456",  "half", "3", "16",  "8", "1" };

type_ext battlemage_acc_datatype   = "spirv" { "4456", "float", "3", "16", "16", "2" };
type_ext battlemage_mat_a_datatype = "spirv" { "4456",  "half", "3", "16", "16", "0" };
type_ext battlemage_mat_b_datatype = "spirv" { "4456",  "half", "3", "16", "16", "1" };

#[import(cc = "device", name = "spirv.operation")] fn spirv_operation[T, S] (i32, T) -> S;
#[import(cc = "device", name = "spirv.extension")] fn spirv_extension (&[u8]) -> ();
#[import(cc = "device", name = "spirv.capability")] fn spirv_capability (i32) -> ();

fn @spirv_matrix_load[T](addr : &[u8], layout : i32, stride : i32) = spirv_operation[(&[u8], i32, i32), T](4457, (addr, layout, stride));
fn @spirv_matrix_store(addr : &mut [u8], c : alchemist_acc_datatype, layout : i32, stride : i32) = spirv_operation[(&[u8], alchemist_acc_datatype, i32, i32), ()](4458, (addr, c, layout, stride));
fn @spirv_matrix_mad(a : alchemist_mat_a_datatype, b : alchemist_mat_b_datatype, c : alchemist_acc_datatype) = spirv_operation[(alchemist_mat_a_datatype, alchemist_mat_b_datatype, alchemist_acc_datatype), alchemist_acc_datatype](4459, (a, b, c));

//TODO: these should be polymorphic.
fn @spirv_matrix_store_battlemage(addr : &mut [u8], c : battlemage_acc_datatype, layout : i32, stride : i32) = spirv_operation[(&[u8], battlemage_acc_datatype, i32, i32), ()](4458, (addr, c, layout, stride));
fn @spirv_matrix_mad_battlemage(a : battlemage_mat_a_datatype, b : battlemage_mat_b_datatype, c : battlemage_acc_datatype) = spirv_operation[(battlemage_mat_a_datatype, battlemage_mat_b_datatype, battlemage_acc_datatype), battlemage_acc_datatype](4459, (a, b, c));

fn @match_layout(addr_mode : AddrMode) -> i32 = match addr_mode {
    AddrMode::RowMajor => 0,
    AddrMode::ColMajor => 1
};

static SPVWMMAOperationsAlchemist = WMMAOperations [alchemist_mat_a_datatype, alchemist_mat_b_datatype, alchemist_acc_datatype] {
    load_a = @|fragment_tensor| {
        spirv_matrix_load[alchemist_mat_a_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    load_b = @|fragment_tensor| {
        spirv_matrix_load[alchemist_mat_b_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    load_c = @|fragment_tensor| {
        spirv_matrix_load[alchemist_acc_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    wmma = @|a_fragment, _a_layout, b_fragment, _b_layout, acc_fragment, _c_layout| {
        spirv_extension ("SPV_KHR_cooperative_matrix");
        spirv_capability (6022); //6022 = CooperativeMatrixKHR
        spirv_matrix_mad(a_fragment, b_fragment, acc_fragment)
    },
    store_d = @|fragment_tensor, acc_fragment| {
        spirv_matrix_store(bitcast[&mut [u8]](fragment_tensor.data), acc_fragment, match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    }
};

static SPVWMMAOperationsBattlemage = WMMAOperations [battlemage_mat_a_datatype, battlemage_mat_b_datatype, battlemage_acc_datatype] {
    load_a = @|fragment_tensor| {
        spirv_matrix_load[battlemage_mat_a_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    load_b = @|fragment_tensor| {
        spirv_matrix_load[battlemage_mat_b_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    load_c = @|fragment_tensor| {
        spirv_matrix_load[battlemage_acc_datatype](bitcast[&[u8]](fragment_tensor.data), match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    },
    wmma = @|a_fragment, _a_layout, b_fragment, _b_layout, acc_fragment, _c_layout| {
        spirv_extension ("SPV_KHR_cooperative_matrix");
        spirv_capability (6022); //6022 = CooperativeMatrixKHR
        spirv_matrix_mad_battlemage(a_fragment, b_fragment, acc_fragment)
    },
    store_d = @|fragment_tensor, acc_fragment| {
        spirv_matrix_store_battlemage(bitcast[&mut [u8]](fragment_tensor.data), acc_fragment, match_layout(fragment_tensor.addr_mode), fragment_tensor.stride)
    }
};
